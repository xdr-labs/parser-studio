{
  "schema": "parserstudio.semantic-goldens.v1",
  "purpose": "Semantic Correctness Oracle. Expected fields are written by hand from the raw line and the cited specification text, never copied from a parser run. Both executors (browser TypeScript and the generated Ruby Fragment on Ruby 2.4.9) are compared with these values, so a result that is wrong in both executors in the same way still fails.",
  "independence": {
    "authoredFrom": "literal raw text plus RFC 3164 section 4.1 and RFC 5424 section 6",
    "notDerivedFrom": [
      "src/**",
      "backend/**",
      "runtime/**",
      "any recorded parser output"
    ],
    "selfCheck": "scripts/verification/semantic-oracle.ts rejects an expected source value that does not occur literally in the raw line"
  },
  "profiles": {
    "fw-kv": {
      "topFields": {
        "body.srcip": [
          "srcip",
          "ip"
        ],
        "body.dstip": [
          "dstip",
          "ip"
        ],
        "body.srcport": [
          "srcport",
          "port"
        ],
        "body.dstport": [
          "dstport",
          "port"
        ],
        "body.action": [
          "action",
          "string"
        ]
      },
      "vendorFields": {
        "syslog_hostname": [
          "syslog_hostname",
          "string"
        ]
      },
      "vendorNamespace": "Synthetic",
      "classification": {
        "defaultIndex": "syslog",
        "rules": [
          {
            "field": "action",
            "operator": "equals",
            "value": "deny",
            "index": "threat"
          },
          {
            "field": "srcip",
            "operator": "exists",
            "index": "session"
          }
        ]
      }
    }
  },
  "knownDefects": {},
  "cases": [
    {
      "id": "rfc3164-tagless-host-kv",
      "grammar": "syslog_rfc3164",
      "body": "kv",
      "raw": "<134>Nov 13 10:00:00 fw01 srcip=10.1.1.1 dstip=10.2.2.2 srcport=1234 dstport=443 action=accept",
      "provenance": "RFC 3164 4.1.1 PRI, 4.1.2 TIMESTAMP SP HOSTNAME; body is key=value CONTENT without TAG",
      "expect": {
        "status": "FULL",
        "source": {
          "syslog_pri": 134,
          "syslog_timestamp": "Nov 13 10:00:00",
          "syslog_hostname": "fw01",
          "body.srcip": "10.1.1.1",
          "body.dstip": "10.2.2.2",
          "body.srcport": "1234",
          "body.dstport": "443",
          "body.action": "accept"
        },
        "sourceAbsent": [
          "syslog_appname",
          "syslog_procid"
        ],
        "event": {
          "srcip": "10.1.1.1",
          "dstip": "10.2.2.2",
          "srcport": 1234,
          "dstport": 443,
          "action": "accept",
          "Synthetic.syslog_hostname": "fw01",
          "stellar_log_index": "session"
        }
      }
    },
    {
      "id": "rfc3164-tagged-pid-deny",
      "grammar": "syslog_rfc3164",
      "body": "kv",
      "raw": "<134>Nov 13 10:00:00 fw01 kernel[77]: srcip=10.1.1.1 dstip=10.2.2.2 dstport=22 action=deny",
      "provenance": "RFC 3164 4.1.3 MSG = TAG CONTENT; TAG 'kernel', bracketed process id, ':' terminator",
      "expect": {
        "status": "FULL",
        "source": {
          "syslog_pri": 134,
          "syslog_hostname": "fw01",
          "syslog_appname": "kernel",
          "syslog_procid": "77",
          "body.srcip": "10.1.1.1",
          "body.dstip": "10.2.2.2",
          "body.dstport": "22",
          "body.action": "deny"
        },
        "event": {
          "srcip": "10.1.1.1",
          "dstip": "10.2.2.2",
          "dstport": 22,
          "action": "deny",
          "Synthetic.syslog_hostname": "fw01",
          "stellar_log_index": "threat"
        },
        "eventAbsent": [
          "srcport"
        ]
      }
    },
    {
      "id": "rfc3164-no-pri-single-digit-day",
      "grammar": "syslog_rfc3164",
      "body": "kv",
      "raw": "Nov  3 09:05:07 gw-2 srcip=192.168.0.254 action=accept",
      "provenance": "RFC 3164 4.1.2: a day below 10 is written with a leading space; a relayed or file-read line may carry no PRI",
      "expect": {
        "status": "FULL",
        "source": {
          "syslog_timestamp": "Nov  3 09:05:07",
          "syslog_hostname": "gw-2",
          "body.srcip": "192.168.0.254",
          "body.action": "accept"
