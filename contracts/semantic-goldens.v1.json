        "sourceAbsent": [
          "syslog_pri",
          "syslog_appname"
        ],
        "event": {
          "srcip": "192.168.0.254",
          "action": "accept",
          "Synthetic.syslog_hostname": "gw-2",
          "stellar_log_index": "session"
        },
        "eventAbsent": [
          "dstip",
          "dstport"
        ]
      }
    },
    {
      "id": "rfc3164-hostless-kv",
      "grammar": "syslog_rfc3164",
      "body": "kv",
      "raw": "<134>Nov 13 10:00:00 srcip=10.1.1.1 dstip=10.2.2.2 srcport=1234 dstport=443 action=accept",
      "provenance": "RFC 952/1123: 'srcip=10.1.1.1' cannot be a host name; RFC 3164 4.3.2 describes messages whose HOSTNAME is missing. Every key=value of the raw line must survive as a field",
      "expect": {
        "status": "FULL",
        "source": {
          "syslog_pri": 134,
          "syslog_timestamp": "Nov 13 10:00:00",
          "body.srcip": "10.1.1.1",
          "body.dstip": "10.2.2.2",
          "body.srcport": "1234",
          "body.dstport": "443",
          "body.action": "accept"
        },
        "sourceAbsent": [
          "syslog_hostname",
          "syslog_appname"
        ],
        "event": {
          "srcip": "10.1.1.1",
          "dstip": "10.2.2.2",
          "srcport": 1234,
          "dstport": 443,
          "action": "accept",
          "stellar_log_index": "session"
        },
        "eventAbsent": [
          "Synthetic.syslog_hostname"
        ]
      }
    },
    {
      "id": "rfc3164-hostless-no-pri-kv",
      "grammar": "syslog_rfc3164",
      "body": "kv",
      "raw": "Jan  1 00:00:00 action=deny srcip=10.9.9.9",
      "provenance": "Same as rfc3164-hostless-kv, without PRI",
      "expect": {
        "status": "FULL",
        "source": {
          "syslog_timestamp": "Jan  1 00:00:00",
          "body.action": "deny",
          "body.srcip": "10.9.9.9"
        },
        "sourceAbsent": [
          "syslog_pri",
          "syslog_hostname"
        ],
        "event": {
          "srcip": "10.9.9.9",
          "action": "deny",
          "stellar_log_index": "threat"
        },
        "eventAbsent": [
          "Synthetic.syslog_hostname"
        ]
      }
    },
    {
      "id": "rfc3164-quoted-value-with-equals",
      "grammar": "syslog_rfc3164",
      "body": "kv",
      "raw": "<134>Nov 13 10:00:00 fw01 srcip=10.1.1.1 msg=\"a=b c\" action=accept",
      "provenance": "A '=' and a space inside a quoted value are data, not a pair boundary",
      "expect": {
        "status": "FULL",
        "source": {
          "syslog_hostname": "fw01",
          "body.srcip": "10.1.1.1",
          "body.msg": "a=b c",
          "body.action": "accept"
        },
        "sourceAbsent": [
          "body.a",
          "body.c"
        ],
        "event": {
          "srcip": "10.1.1.1",
          "action": "accept",
          "stellar_log_index": "session"
        }
      }
    },
    {
      "id": "rfc3164-day-30-february",
      "grammar": "syslog_rfc3164",
      "body": "kv",
      "raw": "<134>Feb 30 10:00:00 fw01 srcip=10.1.1.1 action=accept",
      "provenance": "February never has a 30th day; an impossible TIMESTAMP is not an RFC 3164 header",
      "expect": {
        "status": "UNKNOWN",
        "event": null
      }
    },
    {
      "id": "rfc3164-pri-192",
      "grammar": "syslog_rfc3164",
      "body": "kv",
      "raw": "<192>Nov 13 10:00:00 fw01 srcip=10.1.1.1 action=accept",
      "provenance": "RFC 3164 4.1.1: PRI = facility*8 + severity, facility 0..23, so the maximum is 191",
      "expect": {
        "status": "UNKNOWN",
        "event": null
      }
    },
    {
      "id": "rfc5424-v1-nil-sd-kv",
      "grammar": "syslog_rfc5424",
      "body": "kv",
      "raw": "<165>1 2003-10-11T22:14:15.003Z mymachine.example.com evntslog - ID47 - srcip=10.1.1.1 dstip=10.2.2.2 dstport=443 action=accept",
      "provenance": "RFC 5424 6.5 example 1 header (PRI 165, VERSION 1, HOSTNAME, APP-NAME evntslog, NILVALUE PROCID, MSGID ID47), NILVALUE STRUCTURED-DATA, key=value MSG",
