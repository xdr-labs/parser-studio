  "envelopeCases": [
    {
      "id": "envelope-rfc5424-version-1",
      "raw": "<134>1 2026-11-13T10:00:00Z fw01 app 1 ID1 - free text message",
      "provenance": "RFC 5424 6.2.2 VERSION 1",
      "expect": {
        "variant": "rfc5424"
      }
    },
    {
      "id": "envelope-rfc5424-version-2",
      "raw": "<134>2 2026-11-13T10:00:00Z fw01 app 1 ID1 - free text message",
      "provenance": "RFC 5424 6.2.2: VERSION 2 is not defined; no consumer may label or parse it as RFC 5424",
      "expect": {
        "variantNot": "rfc5424"
      }
    },
    {
      "id": "envelope-rfc5424-version-12",
      "raw": "<134>12 2026-11-13T10:00:00Z fw01 app 1 ID1 - srcip=10.1.1.1 dstip=10.2.2.2",
      "provenance": "RFC 5424 6.2.2: VERSION 12 is not defined",
      "expect": {
        "variantNot": "rfc5424"
      }
    }
  ],
  "resolvedDefects": {
    "F-1": "RFC 3164 line without HOSTNAME lost its first key=value field into the header in both executors. Resolved by BSD_HOSTNAME and the rfc3164_hostless rule of contracts/syslog-header-grammar.v1.json.",
    "F-2": "RFC 5424 VERSION policy differed between consumers. Resolved by semantics.rfc5424SupportedVersions, read by every consumer.",
    "F-3": "U+2028 inside a value was rejected by the browser and parsed by the generated Ruby. Resolved by the portable token REST = [^\\r\\n]+.",
    "F-4": "RFC 5424 TIMESTAMP with an impossible calendar day was rejected by the browser and parsed by the generated Ruby. Resolved by an explicit calendar check beside Time.iso8601 in both Ruby templates.",
    "F-5": "A TAG directly after the timestamp ('kernel:', 'sshd[123]:') was read as HOSTNAME by both executors when HOSTNAME was omitted. Resolved by BSD_HOSTNAME not ending in ':'; the line is declined."
  }
}
