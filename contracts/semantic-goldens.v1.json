        "event": {
          "srcip": "10.1.1.1",
          "action": "deny",
          "stellar_log_index": "threat"
        },
        "eventAbsent": [
          "Synthetic.syslog_hostname"
        ]
      }
    },
    {
      "id": "rfc5424-day-30-february",
      "grammar": "syslog_rfc5424",
      "body": "kv",
      "raw": "<34>1 2026-02-30T22:14:15Z host app 123 ID47 - srcip=10.1.1.1 action=accept",
      "provenance": "RFC 5424 6.2.3 / RFC 3339 5.7: 2026-02-30 is not a date. Found by the independent audit of 2026-11-13 (the browser rejected it, Ruby Time.iso8601 rolled it over).",
      "expect": {
