    {
      "id": "rfc3164-tag-without-hostname",
      "grammar": "syslog_rfc3164",
      "body": "kv",
      "raw": "<13>Oct 11 22:14:15 kernel: srcip=10.1.1.1 action=deny",
      "provenance": "RFC 3164 4.1.3: 'kernel:' is a TAG with its terminating colon, not a HOSTNAME (RFC 952/1123 host names never end in ':'). Until a host-omitted tagged rule exists the line may be declined, but the TAG must never become the host name. Found by the independent audit of 2026-11-13.",
      "expect": {
        "status": "FULL",
