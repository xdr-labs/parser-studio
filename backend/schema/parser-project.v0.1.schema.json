{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:xdr-labs:parser-project:v0.1",
  "title": "Parser Studio portable ParserProject v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaRevision",
    "projectId",
    "revision",
    "slug",
    "vendor",
    "product",
    "sourceCategory",
    "receiver",
    "extraction",
    "normalization",
    "classification"
  ],
  "properties": {
    "schemaRevision": {
      "const": "0.1"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,47}$"
    },
    "vendor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sourceCategory": {
      "type": "string",
      "enum": [
        "network",
        "endpoint",
        "cloud",
        "application",
        "other"
      ]
    },
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocols",
        "port",
        "bindAddress",
        "messageLengthLimit",
        "tcpFraming"
      ],
      "properties": {
        "protocols": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "udp",
              "tcp"
            ]
          }
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "bindAddress": {
          "enum": [
            "0.0.0.0",
            "127.0.0.1"
          ]
        },
        "messageLengthLimit": {
          "type": "integer",
          "minimum": 256,
          "maximum": 65536
        },
        "tcpFraming": {
          "enum": [
            "line",
            "delimiter"
          ]
        },
        "delimiter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8,
          "pattern": "^[A-Za-z0-9_.|^-]+$"
        }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "enum": [
            "json",
            "kv",
            "csv",
            "syslog_rfc3164",
            "syslog_rfc5424",
            "cef",
            "leef"
          ]
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "csvColumns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          }
        },
        "csvDelimiter": {
          "enum": [
            ",",
            ";",
            "\t"
          ]
        },
        "syslogBodyFormat": {
          "enum": [
            "raw",
            "json",
            "kv",
            "cef",
            "leef"
          ]
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "msgOriginSource",
        "msgClass",
        "msgOriginCategory",
        "ignoreValues",
        "topFields",
        "nsFields",
        "vendorFields"
      ],
      "properties": {
        "msgOriginSource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "msgClass": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "msgOriginCategory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ignoreValues": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "topFields": {
          "$ref": "#/$defs/mapping"
        },
        "nsFields": {
          "$ref": "#/$defs/mapping"
        },
        "vendorFields": {
          "$ref": "#/$defs/mapping"
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultIndex",
        "rules"
      ],
      "properties": {
        "defaultIndex": {
          "$ref": "#/$defs/logIndex"
        },
        "rules": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "operator",
              "index"
            ],
            "properties": {
              "field": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)*$",
                "maxLength": 128
              },
              "operator": {
                "enum": [
                  "equals",
                  "exists"
                ]
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 200
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "index": {
                "$ref": "#/$defs/logIndex"
              }
            }
          }
        }
      }
    },
    "unsupportedOpaqueBlocks": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object"
      }
    },
    "enrichment": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operator",
              "target",
              "value"
            ],
            "properties": {
              "operator": {
                "const": "set_const"
              },
              "target": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)*$",
                "maxLength": 128
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 256
                  },
                  {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operator",
              "source",
              "target"
            ],
            "properties": {
              "operator": {
                "const": "copy"
              },
              "source": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)*$",
                "maxLength": 128
              },
              "target": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)*$",
                "maxLength": 128
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operator",
              "source",
              "target"
            ],
            "properties": {
              "operator": {
                "const": "lowercase"
              },
              "source": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)*$",
                "maxLength": 128
              },
              "target": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)*$",
                "maxLength": 128
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operator",
              "source",
              "target"
            ],
            "properties": {
              "operator": {
                "const": "uppercase"
              },
              "source": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)*$",
                "maxLength": 128
              },
              "target": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)*$",
                "maxLength": 128
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "fieldRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalized_name",
        "data_type"
      ],
      "properties": {
        "normalized_name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)*$",
          "minLength": 1,
          "maxLength": 128
        },
        "data_type": {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "ip",
            "port",
            "boolean",
            "date"
          ]
        },
        "time_format": {
          "type": "string",
          "enum": [
            "iso8601"
          ]
        },
        "timezone": {
          "type": "string",
          "enum": [
            "UTC"
          ]
        }
      }
    },
    "mapping": {
      "type": "object",
      "maxProperties": 1000,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)*$",
        "maxLength": 128
      },
      "additionalProperties": {
        "$ref": "#/$defs/fieldRule"
      }
    },
    "logIndex": {
      "enum": [
        "session",
        "threat",
        "syslog",
        "winlogevent"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "extraction": {
            "properties": {
              "format": {
                "enum": [
                  "syslog_rfc3164",
                  "syslog_rfc5424"
                ]
              }
            },
            "required": [
              "format"
            ],
            "type": "object"
          }
        },
        "required": [
          "extraction"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "receiver": {
            "properties": {
              "port": {
                "minimum": 6800,
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  ]
}
