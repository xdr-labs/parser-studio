# CI ONLY. The pinned Stellar Cyber 7.0 observed runtime (Ruby 2.4.9) plus the
# Fluentd release Stellar 7.0 ships (1.7.4) and the rewrite_tag_filter plugin the
# generated .conf routes with. This image is NOT a deployment image and is never
# run with a network: the build may fetch gems, execution may not.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
# RubyGems 2.6 (Ruby 2.4) ignores required_ruby_version while resolving
# dependencies and would pick gems that do not load on 2.4.9.
RUN ruby -e "abort 'WRONG_RUBY' unless RUBY_VERSION == '2.4.9'" && \
    gem update --system 3.2.34 --no-document && \
    gem install fluentd:1.7.4 fluent-plugin-rewrite-tag-filter:2.4.0 --no-document && \
    test "$(gem list -e fluentd)" = "fluentd (1.7.4)" && \
    test "$(fluentd --version)" = "fluentd 1.7.4"
ENV HOME=/tmp
